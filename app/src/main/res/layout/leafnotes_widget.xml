<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="#F1E8D8">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🍃 LeafNotes"
        android:textStyle="bold"
        android:textColor="#206B4D"
        android:textSize="13sp" />
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="LeafNotes"
        android:textColor="#26352D"
        android:textStyle="bold"
        android:textSize="17sp"
        android:maxLines="1" />
    <TextView
        android:id="@+id/widget_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:text="Aucune note pour le moment"
        android:textColor="#46534B"
        android:textSize="13sp"
        android:maxLines="3" />
    <TextView
        android:id="@+id/widget_category"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#206B4D"
        android:textSize="11sp" />
</LinearLayout>
