<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="#DCE7DC">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🍃 LeafNotes"
        android:textColor="#206B4D"
        android:textStyle="bold"
        android:textSize="18sp" />
    <TextView
        android:id="@+id/widget_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="0 note(s) enregistrée(s)"
        android:textColor="#26332B"
        android:textSize="13sp" />
    <TextView
        android:id="@+id/widget_latest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:text="Aucune note"
        android:textColor="#26332B"
        android:textStyle="bold"
        android:textSize="15sp" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Toucher pour ouvrir"
        android:textColor="#206B4D"
        android:textSize="12sp" />
</LinearLayout>
